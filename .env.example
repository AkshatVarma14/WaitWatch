# =============================================================================
# WaitWatch — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure your environment before running Compose:
#   cp .env.example .env
#
# IMPORTANT SECURITY & PRODUCTION NOTICES:
# 1. Never commit the actual .env file containing real secrets to version control.
# 2. The database password below is a non-functional placeholder. Replace it
#    with a strong, unique secret prior to running Docker Compose.
# 3. Production deployments require external secret management, TLS termination,
#    reverse proxy / ingress, and a managed, highly-available PostgreSQL cluster.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Mode
# -----------------------------------------------------------------------------
# Runtime mode: development, test, or production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 2. PostgreSQL / PostGIS Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Change POSTGRES_PASSWORD to a strong, random password.
POSTGRES_USER=waitwatch
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=waitwatch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Async Connection URL:
# - Used by FastAPI and Alembic.
# - Inside Docker Compose, host is 'db'.
# - For local development outside Docker, change host to 'localhost'.
DATABASE_URL=postgresql+asyncpg://waitwatch:replace_with_a_secure_password@db:5432/waitwatch

# -----------------------------------------------------------------------------
# 3. Backend API Service Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Allowed CORS origins (comma-separated list of origins permitted to call the API).
# Note: Browser requests from http://localhost:3000 (web) or http://localhost:5173 (dev)
# must be listed here.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 4. Frontend Web Service Configuration
# -----------------------------------------------------------------------------
# Host port on which the web frontend is published
WEB_PORT=3000

# API URL used by the browser application:
# BROWSER NETWORKING NOTE:
# JavaScript executes in the user's browser, NOT inside the Docker container.
# - Direct browser access: http://localhost:8000 (connects directly to host-published API)
# - Reverse-proxied access: empty string "" (proxies through the Nginx container at /api/)
# - DO NOT set this to http://api:8000 (the browser cannot resolve Docker-internal DNS).
VITE_API_URL=http://localhost:8000

# Map Tile Provider URL (default: standard OpenStreetMap raster tiles)
# For production or high traffic, point to a dedicated vector or raster tile service.
# Reference: https://operations.osmfoundation.org/policies/tiles/
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Real-time polling refresh interval in seconds (default: 30)
VITE_POLLING_INTERVAL_SEC=30

# -----------------------------------------------------------------------------
# 5. Transit Provider API Keys (Optional / Provider-Specific)
# -----------------------------------------------------------------------------
# Feed-specific API keys referenced in transit_feeds table.
# Replace with actual keys provided by transit agencies.
# Obtain a free key from Open Transit Data Delhi: https://otd.delhi.gov.in/
DELHI_TRANSIT_API_KEY=your_delhi_transit_api_key_here

# -----------------------------------------------------------------------------
# 6. Static GTFS Dataset & Setup Configuration
# -----------------------------------------------------------------------------
# Path to the local static GTFS archive zip (default: data/gtfs/delhi-buses.zip).
# If downloaded elsewhere on your machine, set its path here or pass -ArchivePath.
DELHI_GTFS_ARCHIVE_PATH=data/gtfs/delhi-buses.zip

# Optional direct download URL for an authorized static GTFS archive.
# Leave empty if downloading manually from Delhi Transport Stack portal.
DELHI_GTFS_STATIC_URL=

# Optional expected SHA-256 checksum for archive verification prior to ingestion.
# When specified, the setup script verifies the file hash matches before importing.
DELHI_GTFS_STATIC_SHA256=
