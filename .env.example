# =============================================================================
# WaitWatch Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -- Environment --
ENVIRONMENT=development

# -- Database --
DATABASE_URL=postgresql+asyncpg://waitwatch:waitwatch@localhost:5432/waitwatch
POSTGRES_USER=waitwatch
POSTGRES_PASSWORD=waitwatch
POSTGRES_DB=waitwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Backend --
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# -- Frontend --
VITE_API_URL=http://localhost:8000

# -- Transit API Keys --
DELHI_TRANSIT_API_KEY=your_delhi_transit_api_key_here
