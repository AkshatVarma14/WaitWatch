VITE_API_URL=http://localhost:8000

# Interactive Map Tile Provider
# Default: OpenStreetMap standard tiles (for demo / development use only).
# Usage Policy: https://operations.osmfoundation.org/policies/tiles/
# Standard OSM tiles require valid HTTP User-Agent, human-interactive requests only,
# and no bulk caching or offline prefetching.
# For production deployments, configure a commercial or self-hosted tile provider
# (e.g. Mapbox, Stadia Maps, Protomaps, or a vector tile server).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
